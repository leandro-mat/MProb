% Jensen como centro de massa: g(x) = 0,5x^2 + 0,35.
% u = 0,5; v = 2,7; p = 1/2; mu = 1,6.
% g(u) = 0,475; g(v) = 3,995; g(mu) = 1,63; E[g(X)] = 2,235.
\begin{figure}[H]
\centering
\begin{tikzpicture}[x=2.7cm, y=1.45cm, >=latex,
    rot/.style={font=\small},
    projecao/.style={thin, densely dashed, draw=muted!65}]

  \coordinate (P1) at (0.5,0.475);
  \coordinate (P2) at (2.7,3.995);
  \coordinate (A) at (1.6,2.235);
  \coordinate (B) at (1.6,1.63);

  \draw[thin, ->] (-0.12,0) -- (3.25,0) node[below, rot] {$x$};
  \draw[thin, ->] (0,-0.12) -- (0,4.9) node[left, rot] {$y$};

  % As projeções identificam as coordenadas dos dois pontos comparados.
  \draw[projecao] (0,2.235) node[left, rot] {$\mathbb{E}[g(X)]$} -- (A);
  \draw[projecao] (0,1.63) node[left, rot] {$g(\mathbb{E}[X])$} -- (B);
  \draw[projecao] (1.6,0) -- (B);
  \draw[projecao] (0.5,0) -- (P1);
  \draw[projecao] (2.7,0) -- (P2);
  \node[below, rot] at (0.5,0) {$u$};
  \node[below, rot] at (1.6,0) {$\mu=\mathbb{E}[X]$};
  \node[below, rot] at (2.7,0) {$v$};

  \draw[thick, domain=0:2.98, samples=100]
    plot (\x,{0.5*\x*\x+0.35});
  \node[rot, anchor=west] at (2.99,4.65) {$y=g(x)$};

  \draw[thick, muted] (P1) -- (P2)
    node[pos=0.73, above left, rot, text=muted] {corda};
  \fill (P1) circle (2pt);
  \fill (P2) circle (2pt);
  \node[rot, anchor=south east, align=right] at (0.5,0.5)
    {$P_1$};
  \node[rot, anchor=north west, align=left] at (2.77,3.97)
    {$P_2$};

  % A está na corda; B está no gráfico, na mesma abscissa.
  \draw[line width=1.8pt, teal] (B) -- (A);
  \fill[teal] (A) circle (2.5pt);
  \draw[thick, teal, fill=white] (B) circle (2.3pt);
  \node[rot, text=teal, above left=3pt] at (A) {$A$};
  \node[rot, text=teal, below right=3pt] at (B) {$B$};
  \node[rot, text=teal] at (1.74,2.08) {$\Delta$};
\end{tikzpicture}
\caption{Interpretação geométrica de Jensen. O centro de massa $A$ das
massas $p$ e $1-p$ está na corda; o ponto $B$ está no gráfico e tem a mesma
abscissa $\mu=\mathbb{E}[X]$. O segmento destacado tem comprimento
$\Delta=\mathbb{E}[g(X)]-g(\mathbb{E}[X])\geqslant0$.}
\label{fig:jensen-esperanca}
\end{figure}
