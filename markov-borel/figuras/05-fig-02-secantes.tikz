% F2 do levantamento 05-convexidade: as inclinações das secantes crescem.
% g(x) = 0,4x^2 + 0,4; u = 0,4, w = 1,3, v = 2,6.
% g(u) = 0,464; g(w) = 1,076; g(v) = 3,104.
% s_1 = 0,680; s_2 = 1,562; s_uv = 1,200.
\begin{figure}[H]
\centering
\begin{tikzpicture}[x=2.0cm, y=1.35cm, >=latex,
    rot/.style={font=\scriptsize},
    marca/.style={font=\scriptsize, text=muted}]

  % eixos
  \draw[thin, ->] (-0.15,0) -- (3.2,0) node[below, font=\scriptsize] {$x$};
  \draw[thin, ->] (0,-0.1) -- (0,4.6);

  % gráfico de g
  \draw[thick, domain=0:3, samples=120] plot (\x,{0.4*\x*\x+0.4});

  % Catetos dos três triângulos, sem redesenhar os trechos compartilhados.
  \draw[black, densely dashed, line width=0.6pt]
    (0.4,0.464) -- (2.6,0.464) -- (2.6,3.104);
  \draw[black, densely dashed, line width=0.6pt]
    (1.3,0.464) -- (1.3,1.076) -- (2.6,1.076);

  % secantes
  \draw[thick, red] (0.4,0.464) -- (1.3,1.076);
  \draw[thick, black] (1.3,1.076) -- (2.6,3.104);
  \draw[thick, dashed, black] (0.4,0.464) -- (2.6,3.104);

  % pontos
  \fill (0.4,0.464) circle (1.5pt);
  \fill (1.3,1.076) circle (1.5pt);
  \fill (2.6,3.104) circle (1.5pt);

  % marcas no eixo
  \foreach \p in {0.4,1.3,2.6} \draw[thin] (\p,0) -- (\p,-0.07);
  \node[marca, below] at (0.4,-0.05) {$u$};
  \node[marca, below] at (1.3,-0.05) {$w$};
  \node[marca, below] at (2.6,-0.05) {$v$};

\end{tikzpicture}
\caption{Para três pontos $u<w<v$, a inclinação $s_1$ da reta secante sobre $[u,w]$
não excede a inclinação $s_{uv}$ da reta secante sobre $[u,v]$, que por sua vez não
excede a inclinação $s_2$ da reta secante ao longo do subintervalo $[w,v]$.}
\label{fig:convexidade-secantes}
\end{figure}
