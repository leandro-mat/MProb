% O papel das duas propriedades do ínfimo antes de usar continuidade.
\begin{figure}[H]
\centering
\begin{tikzpicture}[x=1.45cm,y=1cm,font=\small]
  \draw[-stealth] (-4.4,0) -- (4.4,0) node[below right] {$x$};
  % Destacamos apenas os pontos estritamente à direita de m:
  % a pertinência de m a S ainda será demonstrada no texto.
  \draw[teal,very thick] (0.04,0) -- (4.1,0);
  \draw (0,-0.1) -- (0,0.1);
  \node[below] at (0,-0.1) {$m=\inf S$};
  \draw (2.6,-0.08) -- (2.6,0.08);
  \node[below] at (2.6,-0.1) {$m+\varepsilon$};
  \fill[teal] (1.1,0) circle (2pt);
  \node[below,teal] at (1.1,-0.1) {$y\in S$};
  \node at (-2.2,0.7) {$x<m\;\Longrightarrow\;F(x)<\frac12$};
  \node[teal] at (2.2,0.7)
    {$x>m\;\Longrightarrow\;F(x)\geqslant\frac12$};
  \draw[gray,dashed] (0,0.18) -- (0,1.45);
  \draw[-stealth,teal] (2.6,1.25) -- (0.16,1.25);
  \node[above,teal,font=\scriptsize] at (1.4,1.3)
    {aproximação pela direita};
  \draw[-stealth] (-2.6,1.25) -- (-0.16,1.25);
  \node[above,font=\scriptsize] at (-1.4,1.3)
    {aproximação pela esquerda};
\end{tikzpicture}
\caption{As duas propriedades do ínfimo localizam os pontos em relação a
$m$. Nenhum ponto menor que $m$ pertence a $S$; para cada
$\varepsilon>0$, há um ponto $y\in S$ entre $m$ e $m+\varepsilon$
(possivelmente $y=m$). A monotonicidade de $F$ garante então que todos os
pontos maiores que $m$ pertencem a $S$. A inclusão do próprio $m$ será
justificada usando a continuidade à direita.}
\label{fig:infimo-mediana}
\end{figure}
