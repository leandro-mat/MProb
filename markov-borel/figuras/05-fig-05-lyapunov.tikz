% F5 do levantamento 05-convexidade: as ordens dos momentos.
% Exemplo: X uniforme em [0,1], donde E|X|^r = 1/(r+1).
% Painel esquerdo: r -> log E|X|^r = -log(r+1), convexa.
%   corda entre r = 0,5 e r = 3,5: f(0,5) = -0,4055, f(3,5) = -1,5041.
%   no ponto r = 2 a corda vale -0,9548 e a curva vale -1,0986.
% Painel direito: r -> (E|X|^r)^{1/r} = (1/(r+1))^{1/r}, crescente.
%   limite em r -> 0: 1/e = 0,3679; limite em r -> infinito: 1.
\begin{figure}[H]
\centering
\begin{minipage}{0.48\linewidth}
\centering
\begin{tikzpicture}
\begin{axis}[
  width=0.98\linewidth, height=5.2cm,
  xmin=0, xmax=4.15, ymin=-1.75, ymax=0.12,
  xtick={0,1,2,3,4}, ytick={-1.5,-1,-0.5,0},
  yticklabels={$-1{,}5$,$-1$,$-0{,}5$,$0$},
  xlabel={$r$}, ylabel={$\log\mathbb{E}|X|^{r}$},
  axis lines=left,
  axis line style={-latex, thin},
  tick label style={font=\scriptsize},
  label style={font=\scriptsize},
  legend style={font=\scriptsize, draw=none, fill=none,
                at={(0.03,0.05)}, anchor=south west},
]
\addplot[thick, black, domain=0:4, samples=120] {-ln(x+1)};
\addlegendentry{$\log\mathbb{E}|X|^{r}$}
\addplot[thick, dashed, muted, domain=0.5:3.5, samples=2]
  {-0.36623*x-0.22238};
\addlegendentry{corda}
\draw[teal, very thick] (axis cs:2,-1.09861) -- (axis cs:2,-0.95484);
\end{axis}
\end{tikzpicture}
\end{minipage}\hfill
\begin{minipage}{0.48\linewidth}
\centering
\begin{tikzpicture}
\begin{axis}[
  width=0.98\linewidth, height=5.2cm,
  xmin=0, xmax=6.2, ymin=0.26, ymax=1.12,
  xtick={0,1,2,3,4,5,6}, ytick={0.4,0.6,0.8,1.0},
  yticklabels={$0{,}4$,$0{,}6$,$0{,}8$,$1$},
  xlabel={$r$}, ylabel={$(\mathbb{E}|X|^{r})^{1/r}$},
  axis lines=left,
  axis line style={-latex, thin},
  tick label style={font=\scriptsize},
  label style={font=\scriptsize},
]
\addplot[thick, black, domain=0.25:6, samples=160]
  {exp(-ln(x+1)/x)};
\addplot[thick, dashed, muted, domain=0:6.1, samples=2] {1};
\addplot[thick, dashed, muted, domain=0:6.1, samples=2] {0.367879};
\node[font=\scriptsize, muted, anchor=south east] at (axis cs:6.1,1.02)
  {supremo essencial $1$};
\node[font=\scriptsize, muted, anchor=south east] at (axis cs:6.1,0.385)
  {$1/e\approx0{,}37$};
\fill (axis cs:1,0.5) circle (1.8pt);
\node[font=\scriptsize, anchor=north west] at (axis cs:1.05,0.49) {$1/2$};
\draw[-latex, thin, muted] (axis cs:2.4,0.47) -- (axis cs:4.4,0.60);
\end{axis}
\end{tikzpicture}
\end{minipage}
\caption{As duas faces da desigualdade de Lyapunov, para $X$ uniforme em
$[0,1]$, de modo que $\mathbb{E}|X|^{r}=1/(r+1)$. À esquerda,
$r\mapsto\log\mathbb{E}|X|^{r}$ é convexa: a corda fica acima do gráfico. À
direita, $r\mapsto(\mathbb{E}|X|^{r})^{1/r}$ é não decrescente, partindo da
média geométrica $1/e$ e tendendo ao supremo essencial $1$.}
\label{fig:lyapunov-ordens}
\end{figure}
